{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "development"
  ],
  "labels": [
    "dependencies"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/requirements_test\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python dependencies"
    },
    {
      "description": "release-please raises this package and its pin in one commit; a Renovate PR would race that.",
      "matchPackageNames": [
        "vallox-rs485-protocol"
      ],
      "enabled": false
    }
  ],
  "schedule": [
    "before 6am on monday"
  ]
}

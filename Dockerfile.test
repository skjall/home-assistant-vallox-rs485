# Test environment. Home Assistant needs Python 3.14.2 from 2026.3 onwards,
# which most systems do not have yet, so this image pins the exact version the
# integration targets. The full Python image rather than -slim, because some
# wheels are built from source and need the libc headers for that.
FROM python:3.14

COPY requirements-test.txt scripts/ha_test_requirements.py /tmp/setup/
# Only the manifest, not the source: it is what declares the requirements, and
# copying it alone means a code change does not rebuild the whole image.
COPY custom_components/*/manifest.json /tmp/setup/

# What the integration imports, and what the Home Assistant components it
# depends on need, both read from files that already exist; see the script for
# why none of it is pinned by hand.
RUN pip install --no-cache-dir -r /tmp/setup/requirements-test.txt \
 && python /tmp/setup/ha_test_requirements.py > /tmp/setup/requirements.txt \
 && pip install --no-cache-dir -r /tmp/setup/requirements.txt \
 && rm -rf /tmp/setup

WORKDIR /app
